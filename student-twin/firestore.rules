rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return hasUserDoc() && getUserData().role == 'admin' && getUserData().active == true;
    }

    function isFaculty() {
      return hasUserDoc() && getUserData().role == 'faculty' && getUserData().active == true;
    }

    function isStudent() {
      return hasUserDoc() && getUserData().role == 'student' && getUserData().active == true;
    }

    // 1. Users collection: primary identity
    match /users/{userId} {
      // Any authenticated user can read their own user record; Admin can read all; Faculty can read assigned students
      allow read: if isOwner(userId) || isAdmin() || isFaculty();

      // Creation: Authenticated user can create their own record or Admin can provision
      allow create: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();

      // Updates: Admin has full access, or user can update non-critical fields
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active'])
      );

      // Deletion: Admin only
      allow delete: if isAdmin();
    }

    // 2. Student Profiles collection
    match /studentProfiles/{studentUid} {
      // Students can read their own profile; Faculty & Admin can read all
      allow read: if isOwner(studentUid) || isAdmin() || isFaculty();

      // Creation during student registration
      allow create: if (isAuthenticated() && request.auth.uid == studentUid) || isAdmin();

      // Updates: Admin, Faculty, or Owner updating permitted fields
      allow update: if isAdmin() || isFaculty() || (
        isOwner(studentUid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'status', 'approved', 'active', 'approvedBy', 'approvedAt', 
          'rejectedBy', 'rejectedAt', 'assignedFacultyUid', 'readinessScore', 'scoreBreakdown'
        ])
      );

      allow delete: if isAdmin();
    }

    // 3. Faculty Profiles collection
    match /facultyProfiles/{facultyUid} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 4. Assessments & Attempts
    match /assessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /assessmentAttempts/{attemptId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isFaculty() || isAdmin()
      );
      // Student can submit attempts for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 5. Companies Directory
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 6. Resume Analyses
    match /resumeAnalyses/{analysisId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isFaculty() || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 7. AI Mock Interviews
    match /mockInterviews/{interviewId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isFaculty() || isAdmin()
      );
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // 8. Learning Roadmaps
    match /learningRoadmaps/{roadmapId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isFaculty() || isAdmin()
      );
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // 9. Faculty Mentoring Notes
    match /facultyNotes/{noteId} {
      allow read: if isAuthenticated() && (
        resource.data.studentUid == request.auth.uid || isFaculty() || isAdmin()
      );
      allow create: if isFaculty() || isAdmin();
      allow update, delete: if (isFaculty() && resource.data.facultyUid == request.auth.uid) || isAdmin();
    }

    // 10. Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Append-only audit log
    }
  }
}
